<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dialyse Android : le site Dialyse (suivi anonymisé du DG et des médecins) dans une application, avec ce qu'un site ne peut pas faire :
         verrou par empreinte et notifications des nouvelles alertes. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notification des nouvelles alertes (Android 13 et plus : l'utilisateur est interrogé) et vérification rejouée après un redémarrage du téléphone -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Verrou de l'application par empreinte (ou code du téléphone) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Android 11+ : voir l'application ShuyahStore installée (bouton « Mettre à jour ») -->
    <queries><package android:name="com.shuyah.store" /></queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Dialyse">
        <!-- Une seule fenêtre. singleTop : le clic sur une notification revient à CETTE fenêtre (onNewIntent). -->
        <activity
            android:name=".WebActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Retour de la connexion par Google : le navigateur ouvre « dialyse://google?code=… » et ramène ici -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dialyse" android:host="google" />
            </intent-filter>
        </activity>
        <!-- Vérification périodique des alertes (JobScheduler) -->
        <service android:name=".Alertes$JobAlertes" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
    </application>
</manifest>
